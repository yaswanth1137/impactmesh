# Client-side Supabase Configuration (Safe for browser via Vite)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Server-side Only Secrets (NEVER expose to Vite frontend or browser bundle)
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# Backend Service Configuration (Server execution environment)
PORT=3001
NODE_ENV=development
